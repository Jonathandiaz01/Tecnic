package com.cursojava.curso.dao;

import com.cursojava.curso.models.Nombre;
import de.mkammerer.argon2.Argon2;
import de.mkammerer.argon2.Argon2Factory;
import org.springframework.stereotype.Repository;
import org.springframework.transaction.annotation.Transactional;

import javax.persistence.EntityManager;
import javax.persistence.PersistenceContext;
import java.util.List;

@Repository
@Transactional
public class ProductosDaoImp implements NombreDao {

    @PersistenceContext
    EntityManager entityManager;

    @Override
    @Transactional
    public List<Nombre> getNombres() {
        String query = "FROM Nombre";
        return entityManager.createQuery(query).getResultList();
    }

    @Override
    public void eliminar(Long id) {
        Nombre Nombre = entityManager.find(Nombre.class, id);
        entityManager.remove(Nombre);
    }

    @Override
    public void registrar(Nombre Nombre) {
        entityManager.merge(Nombre);
    }

    @Override
    public Nombre obtenerNombrePorCredenciales(Nombre Nombre) {
        String query = "FROM Nombre WHERE email = :email";
        List<Nombre> lista = entityManager.createQuery(query)
                .setParameter("email", Nombre.getEmail())
                .getResultList();

        if (lista.isEmpty()) {
            return null;
        }

