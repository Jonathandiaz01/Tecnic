public class ProductosDaoImp implements CedulaDao {

    @PersistenceContext
    EntityManager entityManager;

    @Override
    @Transactional
    public List<Cedula> getCedulas() {
        String query = "FROM Cedula";
        return entityManager.createQuery(query).getResultList();
    }

    @Override
    public void eliminar(Long id) {
        Cedula Cedula = entityManager.find(Cedula.class, id);
        entityManager.remove(Cedula);
    }

    @Override
    public void registrar(Cedula Cedula) {
        entityManager.merge(Cedula);
    }

    @Override
    public Cedula obtenerCedulaPorCredenciales(Cedula Cedula) {
        String query = "FROM Cedula WHERE email = :email";
        List<Cedula> lista = entityManager.createQuery(query)
                .setParameter("email", Cedula.getEmail())
                .getResultList();

        if (lista.isEmpty()) {
            return null;
        }



        String passwordHashed = lista.get(0).getPassword();

        Argon2 argon2 = Argon2Factory.create(Argon2Factory.Argon2Types.ARGON2id);
        if (argon2.verify(passwordHashed, Nombre.getPassword())) {
            return lista.get(0);
        }
        return null;
    }

